<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Управление_Ботами_Discord.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Управление_Ботами_Discord"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Публикация правил" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Отправляйте текст и embed-блоки из Markdown или текстового файла в канал Discord." TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Подключение" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <PasswordBox x:Name="TokenBox" Header="Токен Discord-бота" PlaceholderText="Bot token" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChannelIdBox" Header="ID канала" PlaceholderText="Например, 123456789012345678" />
                            <TextBox x:Name="FirstEmbedColorBox" Grid.Column="1" Header="Цвет первого embed" Text="#00ff00" />
                        </Grid>
                        <TextBlock Text="Токен не сохраняется. Боту нужны права отправки сообщений и встраивания ссылок; для редактирования — также просмотр истории канала." TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Содержимое" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="ChooseFileButton" Content="Выбрать файл…" Click="ChooseFileButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="FilePathTextBlock" Text="Файл не выбран" TextWrapping="Wrap" Opacity="0.75" />
                        <TextBox x:Name="MessageIdBox" Header="ID сообщения для редактирования (необязательно)" PlaceholderText="Оставьте пустым, чтобы отправить новые сообщения" />
                        <TextBlock Text="Разделяйте embed-блоки линией из 10 и более дефисов. После неё можно указать цвет, например: ---------- #00AACC" TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SendButton" Content="Опубликовать / обновить" Click="SendButton_Click" />
                    <ProgressRing x:Name="BusyIndicator" Width="24" Height="24" IsActive="False" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
